# Mandatory Environment Variables
# Get these from @BotFather and my.telegram.org
BOT_TOKEN=
API_ID=
API_HASH=

# Channel IDs (must be negative for channels/supergroups)
# Get by forwarding a message from the channel to @userinfobot
MAIN_CHANNEL=-1001111111111
LOG_CHANNEL=-1001111111111
CLOUD_CHANNEL=-1001111111111
BACKUP_CHANNEL=-1001111111111

# Database
# Get MongoDB connection string from MongoDB Atlas or your MongoDB provider
MONGO_SRV=

# Owner ID (your Telegram user ID)
OWNER=1872074304

# Optional Environment Variables

# Force Subscription Channel (optional)
# Users must join this channel to use the bot
FORCESUB_CHANNEL=
FORCESUB_CHANNEL_LINK=

# Telethon Session String (optional)
# Required for separate channel upload feature
# Generate using: python -c "from telethon.sync import TelegramClient; from telethon.sessions import StringSession; print(StringSession().save(TelegramClient('temp', API_ID, API_HASH).start()))"
SESSION=

# Thumbnail URL (optional)
# Used as default thumbnail for uploads
THUMBNAIL=https://graph.org/file/ad1b25807b81cdf1dff65.jpg

# FFmpeg path (optional)
# Default: ffmpeg (uses system PATH)
FFMPEG=ffmpeg

# CRF Value (optional, default: 27)
# Range: 20-51 (lower = higher quality, larger file)
# 20-23: visually lossless
# 24-27: good quality
# 28-30: acceptable quality
# 31+: lower quality, smaller files
CRF=27

# Send daily anime schedule at 00:30 IST (optional, default: False)
SEND_SCHEDULE=False

# Restart bot daily at 02:01 IST (optional, default: True)
# Set to False on Heroku (uses dyno restart instead)
RESTART_EVERDAY=True

# Send logs to MAIN_CHANNEL instead of LOG_CHANNEL (optional, default: False)
LOG_ON_MAIN=False

# Developer mode (optional, default: False)
# Uses more CPU threads for encoding when True
DEV_MODE=False